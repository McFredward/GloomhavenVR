  <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <application android:label="@string/app_name" android:theme="@style/UnityThemeSelector" android:allowBackup="false" android:extractNativeLibs="true">
    <activity android:name="com.unity3d.player.UnityPlayerActivity" android:exported="true" android:launchMode="singleTask" android:excludeFromRecents="true">
