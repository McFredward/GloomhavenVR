# Binary assets — NEVER apply text/line-ending conversion. On Windows,
# core.autocrlf would insert CRLF into these and corrupt them; for the asset
# bundle that shows up at runtime as:
#   "Unable to read header from archive file ... gloomhavenvr.bundle"
#   AssetBundle.LoadFromFile failed -> procedural visuals
# `binary` = `-text -diff`, so the bytes are checked out verbatim on every platform.
*.bundle binary
*.fbx    binary
*.glb    binary
*.gltf   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.mp4    binary
*.webm   binary
*.tga    binary
*.psd    binary
*.dll    binary
*.so     binary
*.pdb    binary
*.zip    binary
*.tar    binary
*.xz     binary
*.7z     binary
*.pdf    binary
*.alf    binary
*.ulf    binary
*.tpk    binary

# Keep vendored CC0 facial data byte-identical to its recorded upstream hashes.
# The original proxy files include a final empty line; retain it without weakening
# whitespace checks for authored code or documentation.
scripts/npc-face-template/** -text
scripts/npc-face-template/**/*.mhclo whitespace=-blank-at-eof

# Unity writes empty YAML scalar values with a trailing space. Keep the reviewed
# importer metadata byte-identical to the bundle build inputs.
unity/GloomhavenVR.Assets/Assets/Bundle/TownServices/**/*.meta whitespace=-blank-at-eol

# Unity YAML assets stay TEXT (diffable, and CRLF-safe for Unity): *.prefab, *.mat,
# *.asset, *.meta, *.unity — left to default handling on purpose.
