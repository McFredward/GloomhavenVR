<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for GloomhavenVR.
  The BepInEx feed serves BepInEx.Core, BepInEx.PluginInfoProps, BepInEx.Analyzers
  and UnityEngine.Modules (engine reference assemblies, exact game version 2021.3.5).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
