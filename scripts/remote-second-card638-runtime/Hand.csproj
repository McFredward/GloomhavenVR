<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks><AssemblyName>$(CaseName)</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><GenerateDocumentationFile>false</GenerateDocumentationFile><NoWarn>CS0649;CS0414;CS1574</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FixtureDir)/*.cs" /><Compile Include="$(ProductionDir)/*.cs" />
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" />
  </ItemGroup>
</Project>
