<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile><AssemblyName>$(CaseName)</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0414;CS8602;CS8604;CS8625;CS0436;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FixtureDir)/*.cs"/><Compile Include="$(ProductionDir)/*.cs"/>
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll" Private="false"/>
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)/UnityEngine.UI.dll" Private="false"/>
    <Reference Include="GH.Runtime" HintPath="$(GameManaged)/GH.Runtime.dll" Private="false"/>
    <Reference Include="GH.Runtime.FirstPass" HintPath="$(GameManaged)/GH.Runtime.FirstPass.dll" Private="false"/>
  </ItemGroup>
</Project>
