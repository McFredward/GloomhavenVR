<Project>
  <!--
    Per-machine overrides live in Directory.Build.props.user (gitignored).
    It is imported FIRST so any GamePath/GameManaged it sets wins over the
    defaults below (which only apply when the property is still empty).

    Example Directory.Build.props.user:
      <Project>
        <PropertyGroup>
          <GameManaged>/path/to/Gloomhaven_Data/Managed</GameManaged>
        </PropertyGroup>
      </Project>
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <!-- Repo root (this file's directory, trailing slash included) — for libs/ references -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Default: Steam install on Windows. Override per-machine via env var or Directory.Build.props.user. -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Gloomhaven</GamePath>
    <GameManaged Condition="'$(GameManaged)' == ''">$(GamePath)\Gloomhaven_Data\Managed</GameManaged>

    <!--
      CI FALLBACK — committed reference assemblies (libs/RefAsm).

      The game's managed DLLs are the publisher's binaries: never committed, and
      absent on a GitHub-hosted runner. libs/RefAsm holds metadata-only stubs of
      exactly the assemblies the projects reference (scripts/make-refasm.sh,
      libs/RefAsm/README.md) so CI can COMPILE without them.

      Real install ALWAYS wins: the fallback only fires when the resolved
      $(GameManaged) does not actually contain GH.Runtime.dll. Both slash forms are
      tested because MSBuild's Exists() does not normalise '\' on Unix.
    -->
    <GhvrGameManagedIsReal>false</GhvrGameManagedIsReal>
    <GhvrGameManagedIsReal Condition="Exists('$(GameManaged)\GH.Runtime.dll') or Exists('$(GameManaged)/GH.Runtime.dll')">true</GhvrGameManagedIsReal>
    <GhvrUsingRefAsm>false</GhvrUsingRefAsm>
    <GhvrUsingRefAsm Condition="'$(GhvrGameManagedIsReal)' != 'true' and Exists('$(RepoRoot)libs/RefAsm/GH.Runtime.dll')">true</GhvrUsingRefAsm>
    <GameManaged Condition="'$(GhvrUsingRefAsm)' == 'true'">$(RepoRoot)libs/RefAsm</GameManaged>
  </PropertyGroup>

  <!--
    Say it out loud in every build log. A silent fallback is how a developer with a
    mistyped GameManaged ends up compiling against stubs that are one game patch old
    and never finds out.
  -->
  <Target Name="GhvrAnnounceRefAsm" BeforeTargets="ResolveAssemblyReferences" Condition="'$(GhvrUsingRefAsm)' == 'true'">
    <Message Importance="high"
             Text="GloomhavenVR: no game install at '$(GamePath)' — compiling against the committed reference assemblies in libs/RefAsm (metadata only). Regenerate them with scripts/make-refasm.sh after a game update." />
  </Target>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!--
      TreatWarningsAsErrors, on since 2026-08-27 — the day the warning count reached ZERO.
      scripts/ci-build.sh had carried the condition for years: "not on and cannot be turned on
      while those six exist". Six became four became none, so it is on.

      This is the EARLIER of the two levers. The compiler refuses a new warning before anything
      else runs; ci-build.sh's count gate stays as the second, because a compiler-side property
      can be dropped from a file, ignored by another SDK or disabled per project — which is
      exactly how a setting goes quiet without anyone noticing.

      If a warning ever has to be accepted again, suppress it AT THE SITE with the reason
      written beside it (that is what the three `!` in RemoteHandFan / StatPanelSurface do) —
      not by turning this off.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Embedded PDBs => readable stack traces in BepInEx/LogOutput.log -->
    <DebugType>embedded</DebugType>
    <!-- Belt & suspenders next to nuget.config: makes restore work even without it -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>
</Project>
