<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DecisionSource Condition="'$(DecisionSource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/MandatoryDecision.cs</DecisionSource>
    <TermsSource Condition="'$(TermsSource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/MandatoryDecisionTerm.cs</TermsSource>
    <StorySource Condition="'$(StorySource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/NativeStoryWindow.cs</StorySource>
    <CloseScopeSource Condition="'$(CloseScopeSource)' == ''">../../src/GloomhavenVR/WorldUI/MapRoom/TownWindowCloseScope.cs</CloseScopeSource>
    <ProbeSource Condition="'$(ProbeSource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/WindowProbeCadence.cs</ProbeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(DecisionSource)" Link="Production/MandatoryDecision.cs" />
    <Compile Include="$(TermsSource)" Link="Production/MandatoryDecisionTerm.cs" />
    <Compile Include="$(StorySource)" Link="Production/NativeStoryWindow.cs" />
    <Compile Include="$(CloseSource)" Link="Production/Close.cs" />
    <Compile Include="$(CloseScopeSource)" Link="Production/TownWindowCloseScope.cs" />
    <Compile Include="$(ProbeSource)" Link="Production/WindowProbeCadence.cs" />
    <Compile Include="$(EmptyRecoverySource)" Link="Production/EmptyWindowRecovery.cs" />
  </ItemGroup>
</Project>
