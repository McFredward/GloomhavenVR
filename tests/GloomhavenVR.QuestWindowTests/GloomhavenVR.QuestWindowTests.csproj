<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SharedSource Condition="'$(SharedSource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/SharedWindows.cs</SharedSource>
    <QuestWindowSource Condition="'$(QuestWindowSource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/ModalFallback.QuestConfirmation.cs</QuestWindowSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SharedSource)" Link="Production/SharedWindows.cs" />
    <Compile Include="$(QuestWindowSource)" Link="Production/QuestConfirmation.cs" />
  </ItemGroup>
</Project>
