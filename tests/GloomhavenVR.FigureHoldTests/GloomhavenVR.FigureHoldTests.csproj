<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><NoWarn>$(NoWarn);CS8600</NoWarn><GenerateDocumentationFile>false</GenerateDocumentationFile><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MessageSource Condition="'$(MessageSource)' == ''">../../src/GloomhavenVR/Board/FigureGrab/Choreographer_HeldFigureAction_Patch.cs</MessageSource>
    <BusySource Condition="'$(BusySource)' == ''">../../src/GloomhavenVR/Board/FigureGrab/FigureBusy.cs</BusySource>
    <LocalSource Condition="'$(LocalSource)' == ''">../../src/GloomhavenVR/Board/FigureGrab/FigureGrabbable.cs</LocalSource>
    <FigureSource Condition="'$(FigureSource)' == ''">../../src/GloomhavenVR/Net/NetFigures.cs</FigureSource>
    <PatchSource Condition="'$(PatchSource)' == ''">../../src/GloomhavenVR/Board/FigureGrab/ActorBehaviour_HeldTransform_Patch.cs</PatchSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)LocalRelease.g.cs" />
    <Compile Include="../../src/GloomhavenVR/Board/FigureGrab/FigureRingSuppressor.cs" Link="Production/FigureRingSuppressor.cs" />
    <Compile Include="$(FigureSource)" Link="Production/NetFigures.cs" />
    <Compile Include="$(MessageSource)" Link="Production/Choreographer_HeldFigureAction_Patch.cs" />
    <Compile Include="../../src/GloomhavenVR/Board/FigureGrab/MF_HeldFigureAnimation_Patch.cs" Link="Production/MF_HeldFigureAnimation_Patch.cs" />
    <Compile Include="$(PatchSource)" Link="Production/ActorBehaviour_HeldTransform_Patch.cs" />
    <Compile Include="../../src/GloomhavenVR/Board/FigureGrab/NetHeldFigures.cs" Link="Production/NetHeldFigures.cs" />
  </ItemGroup>
  <Target Name="ExtractLocalRelease" BeforeTargets="BeforeCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract-local-release.py&quot; &quot;$(LocalSource)&quot; &quot;$(IntermediateOutputPath)LocalRelease.g.cs&quot; &quot;$(BusySource)&quot; &quot;../../src/GloomhavenVR/Board/FigureGrab/FigureGhosts.cs&quot;" />
  </Target>
</Project>
