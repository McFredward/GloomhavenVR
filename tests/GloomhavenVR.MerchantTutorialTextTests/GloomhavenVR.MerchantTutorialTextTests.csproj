<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MerchantTutorialTextSource Condition="'$(MerchantTutorialTextSource)' == ''">../../src/GloomhavenVR/Compat/Tutorial/MerchantTutorialExitText.cs</MerchantTutorialTextSource>
    <MerchantTutorialLocSource Condition="'$(MerchantTutorialLocSource)' == ''">../../src/GloomhavenVR/Core/Loc/Loc.MerchantTutorial.cs</MerchantTutorialLocSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MerchantTutorialTextSource)" Link="Production/MerchantTutorialExitText.cs" />
    <Compile Include="$(MerchantTutorialLocSource)" Link="Production/Loc.MerchantTutorial.cs" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
</Project>
