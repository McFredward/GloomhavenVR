<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- net472 Dictionary.TryGetValue has no net8 nullable out annotation. -->
    <NoWarn>$(NoWarn);CS8600</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GuardSource Condition="'$(GuardSource)' == ''">../../src/GloomhavenVR/Core/Perf/TickGuard.cs</GuardSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RetirementSource)" Link="Production/Retirement.cs" />
    <Compile Include="$(GuardSource)" Link="Production/TickGuard.cs" />
  </ItemGroup>
</Project>
