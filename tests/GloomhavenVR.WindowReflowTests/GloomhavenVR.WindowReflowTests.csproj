<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PoseSource Condition="'$(PoseSource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/WindowReflowPose.cs</PoseSource>
    <LayoutSource Condition="'$(LayoutSource)' == ''">../../src/GloomhavenVR/WorldUI/Modal/WindowReflowLayout.cs</LayoutSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LayoutSource)" Link="Production/WindowReflowLayout.cs" />
    <Compile Include="Program.cs" /><Compile Include="Stubs.cs" />
    <Compile Include="$(PoseSource)" Link="Production/WindowReflowPose.cs" />
  </ItemGroup>
</Project>
