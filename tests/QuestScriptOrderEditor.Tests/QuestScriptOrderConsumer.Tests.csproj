<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ScriptOrderSource Condition="'$(ScriptOrderSource)' == ''">../../unity/GloomhavenVR.Quest/Assets/Quest/Editor/QuestOriginalScriptOrders.cs</ScriptOrderSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ScriptOrderSource)" Link="QuestOriginalScriptOrders.cs" />
    <Compile Include="ConsumerStubs.cs" />
    <Compile Include="ConsumerProgram.cs" />
  </ItemGroup>
</Project>
