<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><DefineConstants>GHVR_QUEST_STARTUP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/GloomhavenVR.Quest/Assets/Quest/Runtime/QuestGameNetwork.cs" Link="QuestGameNetwork.cs" />
    <Compile Include="../../unity/GloomhavenVR.Quest/Assets/Quest/Runtime/QuestGameNetwork.Aot.cs" Link="QuestGameNetwork.Aot.cs" />
    <Reference Include="GloomhavenVR"><HintPath>$(QuestNetworkPluginsRoot)/QuestGame/GloomhavenVR.dll</HintPath></Reference>
    <Reference Include="GH.Runtime"><HintPath>$(QuestNetworkPluginsRoot)/GH.Runtime.dll</HintPath></Reference>
    <Reference Include="GH.Shared"><HintPath>$(QuestNetworkPluginsRoot)/GH.Shared.dll</HintPath></Reference>
