    <Reference Include="PhotonVoice.API"><HintPath>$(QuestNetworkPluginsRoot)/PhotonVoice.API.dll</HintPath></Reference>
    <Reference Include="Photon3Unity3D"><HintPath>$(QuestNetworkPluginsRoot)/Photon3Unity3D.dll</HintPath></Reference>
    <Reference Include="bolt"><HintPath>$(QuestNetworkPluginsRoot)/bolt.dll</HintPath></Reference>
    <Reference Include="bolt.user"><HintPath>$(QuestNetworkPluginsRoot)/bolt.user.dll</HintPath></Reference>
    <Reference Include="udpkit"><HintPath>$(QuestNetworkPluginsRoot)/udpkit.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityManagedRoot)/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(UnityManagedRoot)/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(UnityManagedRoot)/UnityEngine.AudioModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AndroidJNIModule"><HintPath>$(UnityManagedRoot)/UnityEngine.AndroidJNIModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
