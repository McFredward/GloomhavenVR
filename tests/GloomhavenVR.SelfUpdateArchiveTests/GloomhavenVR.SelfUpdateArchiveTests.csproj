<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ZipSource Condition="'$(ZipSource)' == ''">../../src/GloomhavenVR/Core/SelfUpdate/SelfUpdateZip.cs</ZipSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ZipSource)" Link="Production/SelfUpdateZip.cs" />
    <Compile Include="../../src/GloomhavenVR/Core/SelfUpdate/SelfUpdateApplyScript.cs" Link="Production/SelfUpdateApplyScript.cs" />
  </ItemGroup>
</Project>
