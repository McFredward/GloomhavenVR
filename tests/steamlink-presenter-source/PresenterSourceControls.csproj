<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SourceRoot Condition="'$(SourceRoot)' == ''">$(MSBuildProjectDirectory)/../..</SourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SourceRoot)/src/GloomhavenVR/Core/SteamLink/ProbePolicy.cs" />
    <Compile Include="$(SourceRoot)/src/GloomhavenVR/Core/SteamLink/ProbeManifest.cs" />
    <Compile Include="$(SourceRoot)/src/GloomhavenVR/Core/SteamLink/RegistrationPairPolicy.cs" />
    <Compile Include="$(SourceRoot)/src/GloomhavenVR/Core/SteamLink/RegistrationSource.cs" />
    <Compile Include="$(SourceRoot)/src/GloomhavenVR/Core/SteamLink/PresenterSource.cs" />
    <Compile Include="$(SourceRoot)/tests/steamlink-presenter-source/Program.cs" />
  </ItemGroup>
</Project>
