<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlaybackSource Condition="'$(PlaybackSource)' == ''">../../src/GloomhavenVR/Net/Remote/RemoteVideoPlayback.cs</PlaybackSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PlaybackSource)" Link="Production/RemoteVideoPlayback.cs" />
    <Compile Include="../../src/GloomhavenVR/Net/VideoWindowState.cs" Link="Production/VideoWindowState.cs" />
  </ItemGroup>
</Project>
