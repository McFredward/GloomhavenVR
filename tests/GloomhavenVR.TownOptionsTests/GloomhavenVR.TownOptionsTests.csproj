<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Production targets net472, whose Dictionary.TryGetValue lacks net8 nullable metadata. -->
    <NoWarn>$(NoWarn);CS8600</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(OptionsSource)" Link="Production/TownOptions.cs" /></ItemGroup>
</Project>
