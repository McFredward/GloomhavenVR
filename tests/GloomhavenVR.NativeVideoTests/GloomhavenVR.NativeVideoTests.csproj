<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VideoSource Condition="'$(VideoSource)' == ''">../../src/GloomhavenVR/WorldUI/FlatScreen/NativeVideoWindow.cs</VideoSource>
    <VideoPlacementSource Condition="'$(VideoPlacementSource)' == ''">../../src/GloomhavenVR/WorldUI/FlatScreen/NativeVideoWindow.SharedPlacement.cs</VideoPlacementSource>
    <MovieSource Condition="'$(MovieSource)' == ''">../../src/GloomhavenVR/WorldUI/FlatScreen/NativeVideoMovies.cs</MovieSource>
    <MovieKeySource Condition="'$(MovieKeySource)' == ''">../../src/GloomhavenVR/Net/VideoWindowState.cs</MovieKeySource>
    <ReviewSource Condition="'$(ReviewSource)' == ''">../../src/GloomhavenVR/WorldUI/FlatScreen/NativeVideoReview.cs</ReviewSource>
    <EmbeddedSource Condition="'$(EmbeddedSource)' == ''">../../src/GloomhavenVR/WorldUI/FlatScreen/NativeEmbeddedMoviePatches.cs</EmbeddedSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(VideoSource)" Link="Production/NativeVideoWindow.cs" />
    <Compile Include="$(VideoPlacementSource)" Link="Production/NativeVideoWindow.SharedPlacement.cs" />
    <Compile Include="$(MovieSource)" Link="Production/NativeVideoMovies.cs" />
    <Compile Include="$(ReviewSource)" Link="Production/NativeVideoReview.cs" />
    <Compile Include="$(EmbeddedSource)" Link="Production/NativeEmbeddedMoviePatches.cs" />
    <Compile Include="$(MovieKeySource)" Link="Production/VideoWindowState.cs" />
    <Compile Include="$(ChromeSweepSource)" Link="Production/ModalChromeSweep.cs" />
    <Compile Include="$(PointerGuardSource)" Link="Production/PointerGuard.cs" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Lib.Harmony" Version="2.4.2" /></ItemGroup>
</Project>
