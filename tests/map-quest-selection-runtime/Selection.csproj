<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SelectionSource Condition="'$(SelectionSource)' == ''">../../src/GloomhavenVR/WorldUI/MapRoom/NativeMapQuestSelection.cs</SelectionSource>
    <InteractorSource Condition="'$(InteractorSource)' == ''">../../src/GloomhavenVR/WorldUI/MapRoom/MapLocationInteractor.cs</InteractorSource>
    <RemoteRoomSource Condition="'$(RemoteRoomSource)' == ''">../../src/GloomhavenVR/Net/Remote/RemoteMapRoom.cs</RemoteRoomSource>
    <VersionSource Condition="'$(VersionSource)' == ''">../../src/GloomhavenVR/Net/SharedQuestSelectionVersion.cs</VersionSource>
    <BoundarySource Condition="'$(BoundarySource)' == ''">Boundary.cs</BoundarySource>
    <MapGateSource Condition="'$(MapGateSource)' == ''">../../src/GloomhavenVR/WorldUI/MapRoom/MapInputGate.cs</MapGateSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Boundary.cs" />
    <Compile Include="$(BoundarySource)" Link="Boundary.cs" />
    <Compile Include="$(SelectionSource)" Link="Production/NativeMapQuestSelection.cs" />
    <Compile Include="$(MapGateSource)" Link="Production/MapInputGate.cs" />
    <Compile Include="$(VersionSource)" Link="Production/SharedQuestSelectionVersion.cs" />
    <Compile Include="$(IntermediateOutputPath)Observer.g.cs" />
  </ItemGroup>
  <Target Name="ExtractObserver" BeforeTargets="BeforeCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract-observer.py&quot; &quot;$(InteractorSource)&quot; &quot;$(IntermediateOutputPath)Observer.g.cs&quot; &quot;$(RemoteRoomSource)&quot;" />
  </Target>
</Project>
