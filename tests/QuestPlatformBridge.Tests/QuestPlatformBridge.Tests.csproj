<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Reuse the weaver's existing friend access in this separate fixture process. -->
    <AssemblyName>QuestWeaver.Tests</AssemblyName>
    <WeaverProjectPath Condition="'$(WeaverProjectPath)' == ''">../../tools/QuestWeaver/QuestWeaver.csproj</WeaverProjectPath>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(WeaverProjectPath)" /></ItemGroup>
</Project>
