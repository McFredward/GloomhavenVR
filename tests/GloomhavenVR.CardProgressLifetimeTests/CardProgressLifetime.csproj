    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="Ports.cs" />
    <Compile Include="NativeMethods.cs" /><Compile Include="DriverMethods.cs" /><Compile Include="MirrorMethods.cs" /><Compile Include="HelpDefaults.cs" />
    <Compile Include="$(QueueSource)" Link="Production/CardActionQueue.cs" />
    <Compile Include="$(LifetimeSource)" Link="Production/NativeCardAnimationLifetime.cs" />
    <Compile Include="$(ProgressSource)" Link="Production/CardsDriver.ProgressHelp.cs" />
    <Compile Include="$(HelpClockSource)" Link="Production/DecisionHelpClock.cs" />
    <Compile Include="$(HelpLocSource)" Link="Production/Loc.ProgressHelp.cs" />
  </ItemGroup>
</Project>
