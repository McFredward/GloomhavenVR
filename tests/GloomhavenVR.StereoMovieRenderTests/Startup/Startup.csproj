<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS0414;CS0649</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>$(CaseName)</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(FixtureDir)/*.cs"/><Compile Include="$(ProductionDir)/*.cs"/>
    <Reference Include="$(UnityManaged)/UnityEngine/*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameManaged)/UnityEngine.UI.dll"><Private>false</Private></Reference>
    <EmbeddedResource Include="$(StereoBundle)" LogicalName="GloomhavenVR.StereoVideo.ui-sbs.bundle"/>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.BaseLib" Version="5.4.20"/>
    <PackageReference Include="Lib.Harmony" Version="2.4.2"/>
  </ItemGroup>
</Project>
