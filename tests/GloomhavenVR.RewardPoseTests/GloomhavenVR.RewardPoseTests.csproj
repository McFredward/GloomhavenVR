<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)../../</RepoRoot>
    <HandshakeSource Condition="'$(HandshakeSource)' == ''">$(RepoRoot)src/GloomhavenVR/Net/RewardPoseHandshake.cs</HandshakeSource>
    <RewardSource Condition="'$(RewardSource)' == ''">$(RepoRoot)src/GloomhavenVR/Net/Remote/RemoteMapStory.Reward.cs</RewardSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(HandshakeSource)" Link="Production/RewardPoseHandshake.cs" />
    <Compile Include="$(RewardSource)" Link="Production/RemoteMapStory.Reward.cs" />
    <Compile Include="$(RepoRoot)src/GloomhavenVR/Net/MapStoryOpeningLedger.cs" Link="Production/MapStoryOpeningLedger.cs" />
    <Compile Include="$(RepoRoot)src/GloomhavenVR/Net/MapStoryLifecycleState.cs" Link="Production/MapStoryLifecycleState.cs" />
    <Compile Include="$(PostQuestIdentitySource)" Link="Production/PostQuestRewardIdentity.cs" />
  </ItemGroup>
</Project>
