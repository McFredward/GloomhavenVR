# Game files & decompiled sources — never committed
ressources/
decompiled/
*.dll

# ...EXCEPT the stripped reference assemblies. These are metadata-only stubs
# (public+internal+private SIGNATURES, zero method bodies) generated from the game's
# managed DLLs by scripts/make-refasm.sh so the GitHub runner can compile without a
# game install. They contain no executable game code — scripts/check-refasm.py proves
# it by asserting every MethodDef RVA is 0, and CI re-runs that on every push.
# See libs/RefAsm/README.md.
!libs/RefAsm/*.dll

# .NET build artifacts
bin/
obj/
artifacts/
*.binlog
*.nupkg

# Python bytecode from scripts/
__pycache__/

# IDE
.vs/
.idea/
*.user
*.suo

# Per-machine build overrides (see README — developer setup)
Directory.Build.props.user

# XR package sources fetched by scripts/build-runtimedeps.sh (Unity Companion License — never committed)
tools/RuntimeDepsBuild/sources/

# Generated per-build provenance record
libs/RuntimeDeps/versions.json

# Release packaging output (scripts/package-release.sh)
dist/
*.zip

# local debug drops (never push)
.planning/debug/

# harness worktrees/session data. The GUARD is the exception and is tracked on purpose:
# a safety hook that only exists in one checkout protects one checkout. settings.local.json
# (per-machine) and worktrees/ (churn) stay out.
.claude/*
!.claude/settings.json
!.claude/hooks/
decompiled-demeo/
unity/board-prep/out/
# The keycap pipeline's own scratch: generated plates, palette reference crops and the atlases as
# built for a local check. The SHIPPED atlases live in Assets/Bundle/Table and ARE tracked; this is
# the working directory beside them, exactly like ../out/ above.
unity/board-prep/buttons/out/
unity/mask-prep/out/
.planning/refactor/.guard/
ressources

# hands asset build log (Unity batch)
buildhands.log

# build transcript kept by scripts/ci-build.sh for the warning gate
build-ci.log

# environment bake / preview transcripts (Unity batch). build-bundles.log IS tracked —
# it is the record of which editor wrote the shipped bundle — but the per-round bake and
# preview logs are scratch and land at the repo root by default.
env-build*.log
env-preview*.log

# release notes rendered by .github/workflows/release.yml
RELEASE_NOTES.md

#env file
*.env
# media-pipeline plugin fallback output (before IMAGE_OUTPUT_DIR takes effect)
generated-images/
board-build.log
board-preview.log
# …and the keycap station's, which lands beside it (Editor/PreviewKeycaps.cs).
keycap-preview.log
unity/board-prep/img2img/.aniso_ref/
unity/GloomhavenVR.Assets/board-unity-preview.png
render/windowmaterialise/
render/clouds/
cloud-preview.log
.planning/refactor/census-2026-08/*.json
.planning/refactor/census-2026-08/__pycache__/

# ---------------------------------------------------------------------------------------------
# RENDERS AND SCREENSHOTS DO NOT BELONG IN THE TRACKED PLANNING TREE (user ruling, 2026-09-02:
# "es sieht so aus, dass du mittlerweile in planning auch render Bilder reingepusht hast — dafür
# gibt es den debug folder in planning, der steht in gitignore"). Eight megabytes of preview PNGs
# had accumulated across .planning/{cellar-2026-09,forest-clouds,cloth-cook-harness,voice}/ and
# were untracked in ModBuild 338; every markdown reference was rewritten to the new location so
# no link rotted. .planning/debug/ is already ignored below — put renders under
# .planning/debug/renders/ and LINK to them from the doc.
# The docs themselves stay tracked: it is the pixels that are disposable, not the reasoning.
.planning/**/*.png
.planning/**/*.jpg
.planning/**/*.jpeg
.planning/**/*.gif
.planning/**/*.mp4
