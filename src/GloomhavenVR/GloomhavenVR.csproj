<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GloomhavenVR</AssemblyName>
    <RootNamespace>GloomhavenVR</RootNamespace>
    <Version>1.0.1</Version>
    <Description>Demeo-style room-scale VR mod for Gloomhaven (digital).</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Consumed by BepInEx.PluginInfoProps -> MyPluginInfo -->
    <BepInExPluginGuid>dev.gloomhavenvr</BepInExPluginGuid>
    <BepInExPluginName>GloomhavenVR</BepInExPluginName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Art shipped INSIDE the plugin DLL (user request 2026-08-22 #5, the main-menu wordmark —
      see WorldUI/Patches/MainMenuLogoSwap.cs). The asset bundle would be the natural home, but it
      has been byte-identical at 70,218,494 bytes since ModBuild 172 and every install since is
      plugin-DLL-only; rebuilding it would cost the user a full reinstall for a logo. LogicalName
      is pinned so a folder rename cannot silently change the manifest name the loader asks for.
    -->
    <EmbeddedResource Include="Assets\GloomhavenVR_logo.png"
                      LogicalName="GloomhavenVR.Assets.GloomhavenVR_logo.png" />

    <!--
      THE FOUR GRAB-BAR ALBEDO STRIPS, for the same reason and by the same route as the wordmark
      above: the bundle has been byte-identical since ModBuild 296 and every install since is
      plugin-DLL-only, so four small handle textures do not get to cost the user a re-install.
      1024x256 each, ~1.4 MB for the set. LogicalName is pinned so a folder rename cannot silently
      change the manifest name Core/GrabBarTexture.cs asks for. They are BUILT, not hand-painted —
      scripts/grabbar-strips.py composites them from the swatches in unity/board-prep/grabbar/ and
      reads the band boundary out of GrabBarTexture.ShaftU0 so the layout cannot drift away from
      the mesh's UVs.
    -->
    <EmbeddedResource Include="Assets\grabbar_oak.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_oak.png" />
    <EmbeddedResource Include="Assets\grabbar_steel.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_steel.png" />
    <EmbeddedResource Include="Assets\grabbar_bronze.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_bronze.png" />
    <EmbeddedResource Include="Assets\grabbar_generic.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_generic.png" />

    <!--
      NORMAL + MRS for the three LIT rods. GloomhavenVR/BoardLit gates its specular block behind
      _SpecStrength > 0 and reads _BumpMap / _MRSMap (R = metallic, G = roughness); without these
      the rods render matte. The GENERIC rod has none on purpose — it draws through the unlit
      Overlay shader, which samples _MainTex * _Color and nothing else, so a normal map for it
      would be a texture nothing ever reads.
    -->
    <EmbeddedResource Include="Assets\grabbar_oak_n.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_oak_n.png" />
    <EmbeddedResource Include="Assets\grabbar_oak_mrs.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_oak_mrs.png" />
    <EmbeddedResource Include="Assets\grabbar_steel_n.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_steel_n.png" />
    <EmbeddedResource Include="Assets\grabbar_steel_mrs.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_steel_mrs.png" />
    <EmbeddedResource Include="Assets\grabbar_bronze_n.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_bronze_n.png" />
    <EmbeddedResource Include="Assets\grabbar_bronze_mrs.png"
                      LogicalName="GloomhavenVR.Assets.grabbar_bronze_mrs.png" />

    <!--
      THE SHARED-WINDOW BADGE. Replaces the blue grab bar that used to mark a multiplayer window:
      a small unobtrusive 'two players' glyph in the window's top-right corner, RGBA with a keyed
      alpha. Cut from the six-variant sheet the user picked from, not regenerated — the sheet is
      what was approved.
    -->
    <EmbeddedResource Include="Assets\net_shared.png"
                      LogicalName="GloomhavenVR.Assets.net_shared.png" />
    <!-- Asset-picker thumbnails stay in the DLL, with stable manifest names, so menu artwork
      updates do not require replacing the full asset bundle. -->
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_env_default.png"
                      LogicalName="GloomhavenVR.Assets.tile_env_default.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_env_cellar.png"
                      LogicalName="GloomhavenVR.Assets.tile_env_cellar.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_env_swamp.png"
                      LogicalName="GloomhavenVR.Assets.tile_env_swamp.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_env_offblack.png"
                      LogicalName="GloomhavenVR.Assets.tile_env_offblack.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_env_mr.png"
                      LogicalName="GloomhavenVR.Assets.tile_env_mr.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_hand_glove.png"
                      LogicalName="GloomhavenVR.Assets.tile_hand_glove.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_hand_plate.png"
                      LogicalName="GloomhavenVR.Assets.tile_hand_plate.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_hand_arcane.png"
                      LogicalName="GloomhavenVR.Assets.tile_hand_arcane.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_mask_0.png"
                      LogicalName="GloomhavenVR.Assets.tile_mask_0.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_mask_1.png"
                      LogicalName="GloomhavenVR.Assets.tile_mask_1.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_mask_2.png"
                      LogicalName="GloomhavenVR.Assets.tile_mask_2.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_board_oak.png"
                      LogicalName="GloomhavenVR.Assets.tile_board_oak.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_board_steel.png"
                      LogicalName="GloomhavenVR.Assets.tile_board_steel.png" />
    <EmbeddedResource Include="WorldUI\Options\VariantTiles\tile_board_bronze.png"
                      LogicalName="GloomhavenVR.Assets.tile_board_bronze.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.5" IncludeAssets="compile" />
    <!-- ExcludeAssets=runtime keeps the publicizer's tooling DLLs (AsmResolver.*) out of bin/ -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"
                      PrivateAssets="all" Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Game assemblies: referenced from the local install ($(GameManaged), see
      Directory.Build.props), publicized at build time (internals usable without
      reflection), never copied to the output (Private=false).
    -->
    <Reference Include="GH.Runtime" HintPath="$(GameManaged)\GH.Runtime.dll" Publicize="true" Private="false" />
    <Reference Include="GH.Runtime.FirstPass" HintPath="$(GameManaged)\GH.Runtime.FirstPass.dll" Publicize="true" Private="false" />
    <Reference Include="GH.Shared" HintPath="$(GameManaged)\GH.Shared.dll" Publicize="true" Private="false" />
    <Reference Include="ScenarioRuleLibrary" HintPath="$(GameManaged)\ScenarioRuleLibrary.dll" Publicize="true" Private="false" />
    <Reference Include="MapRuleLibrary" HintPath="$(GameManaged)\MapRuleLibrary.dll" Publicize="true" Private="false" />
    <Reference Include="InControl" HintPath="$(GameManaged)\InControl.dll" Publicize="true" Private="false" />
    <!-- Apparance.Unity: ApparanceEngine (procedural map synthesis). Core.ApparanceDetailFocus
         points its EnableDetailFocus/DetailFocus viewpoint override at the VR head — the engine
         otherwise centres detail generation on the PARKED Camera.main and mid-scenario room
         reveals never synthesize their geometry. Publicized for census diagnostics
         (ApparanceEntity build state). -->
    <Reference Include="Apparance.Unity" HintPath="$(GameManaged)\Apparance.Unity.dll" Publicize="true" Private="false" />
    <!-- Utilities.dll: VirtualMouseUtilities / InputSystemUtilities (PATCH-TARGETS §2 — separate assembly!) -->
    <Reference Include="Utilities" HintPath="$(GameManaged)\Utilities.dll" Publicize="true" Private="false" />
    <!-- ThirdParty.dll: defines I2.Loc.LocalizationManager (CurrentLanguage / OnLocalizeEvent) —
         the engine localization the GLOOM facade wraps; the mod reads + subscribes (never sets). -->
    <Reference Include="ThirdParty" HintPath="$(GameManaged)\ThirdParty.dll" Private="false" />
    <!-- uGUI: GraphicRaycaster + UnityEngine.EventSystems (ExecuteEvents) live here in 2021.3 -->
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(GameManaged)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.Addressables" HintPath="$(GameManaged)\Unity.Addressables.dll" Private="false" />
    <Reference Include="Unity.ResourceManager" HintPath="$(GameManaged)\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Private="false" />
    <!-- Game-shipped TrackedPoseDriver (com.unity.xr.legacyinputhelpers runtime) — drives the P1 head pose -->
    <Reference Include="UnityEngine.SpatialTracking" HintPath="$(GameManaged)\UnityEngine.SpatialTracking.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Mod-shipped XR assemblies (libs/RuntimeDeps — produced by scripts/build-runtimedeps.sh,
      later replaced by the editor harvest). Publicized: the OpenXR bootstrap uses internal
      members (XRGeneralSettings.InitXRSDK/Start, OpenXRSettings.features, ...) directly.
      Private=false: they are deployed separately to BepInEx/plugins/GloomhavenVR/RuntimeDeps/
      and loaded via Assembly.LoadFile (never next to the plugin DLL itself).
    -->
    <Reference Include="Unity.XR.Management" HintPath="$(RepoRoot)libs\RuntimeDeps\Unity.XR.Management.dll" Publicize="true" Private="false" />
    <Reference Include="Unity.XR.CoreUtils" HintPath="$(RepoRoot)libs\RuntimeDeps\Unity.XR.CoreUtils.dll" Publicize="true" Private="false" />
    <Reference Include="Unity.XR.OpenXR" HintPath="$(RepoRoot)libs\RuntimeDeps\Unity.XR.OpenXR.dll" Publicize="true" Private="false" />
  </ItemGroup>

  <Target Name="CheckRuntimeDeps" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RepoRoot)libs\RuntimeDeps\Unity.XR.OpenXR.dll')"
           Text="libs/RuntimeDeps is not populated — run scripts/build-runtimedeps.sh first (see libs/RuntimeDeps/README.md)." />
  </Target>

  <!-- Stamp the git commit + build time INTO the DLL so the running build is identifiable
       from the log (no more "did I test the right version?"). Regenerated every build. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile;CoreCompile">
    <Exec Command="git rev-parse --short=9 HEAD" ConsoleToMSBuild="true" ContinueOnError="true"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitHash" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>
    <Exec Command="git rev-parse --abbrev-ref HEAD" ConsoleToMSBuild="true" ContinueOnError="true"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitBranch" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" ContinueOnError="true"
          WorkingDirectory="$(MSBuildProjectDirectory)" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirty" />
    </Exec>
    <!-- NOTE: do NOT fetch the commit subject via a git pretty/format placeholder here: the
         percent-s token is eaten by Windows cmd inside an MSBuild Exec (works on Linux, breaks
         on Windows, so the whole default git-show output leaks into the stamp). Hash + branch +
         build time already identify the build unambiguously; install.ps1 prints the subject. -->
    <PropertyGroup>
      <!-- GloomhavenVR.Core.BuildInfo.Commit: the SHORT (7) hash, before the -dirty suffix is
           appended below, and EMPTY when git could not answer (no git on PATH, or a source
           drop that is not a checkout). Nothing here may fail the build: the Execs above are
           ContinueOnError, so a missing git leaves _GitExit non-zero and this stays empty. -->
      <_GhvrCommit Condition="'$(_GitExit)' == '0'">$(_GitHash)</_GhvrCommit>
      <_GhvrCommit Condition="'$(_GhvrCommit)' == 'unknown'"></_GhvrCommit>
      <_GhvrCommit Condition="'$(_GhvrCommit)' != '' and $(_GhvrCommit.Length) &gt; 7">$(_GhvrCommit.Substring(0, 7))</_GhvrCommit>
      <!-- Set by the release workflow (-p:GhvrReleaseBuild=true). Absent/empty = dev build. -->
      <_GhvrIsDev>true</_GhvrIsDev>
      <_GhvrIsDev Condition="'$(GhvrReleaseBuild)' == 'true'">false</_GhvrIsDev>
      <_GitHash Condition="'$(_GitExit)' != '0' or '$(_GitHash)' == ''">unknown</_GitHash>
      <_GitHash Condition="'$(_GitDirty)' != ''">$(_GitHash)-dirty</_GitHash>
      <!-- "unknown", NOT "?": the value is pasted into an <_L Include="..."> below, and MSBuild
           treats ? and * in an Include as WILDCARDS. A "?" branch matched no file, so the whole
           GitBranch item silently evaporated and the generated class came out without the field —
           i.e. the build failed to compile Plugin.cs on exactly the machine that has no git,
           which is the one case this fallback exists for. -->
      <_GitBranch Condition="'$(_GitBranch)' == ''">unknown</_GitBranch>
      <_BuildTime>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss'))</_BuildTime>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
      <_GhvrBuildInfoFile>$(IntermediateOutputPath)BuildInfo.Core.g.cs</_GhvrBuildInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_L Include="namespace GloomhavenVR { internal static class BuildInfo {" />
      <_L Include="public const string GitHash = &quot;$(_GitHash)&quot;%3B" />
      <_L Include="public const string GitBranch = &quot;$(_GitBranch)&quot;%3B" />
      <_L Include="public const string BuildTimeUtc = &quot;$(_BuildTime) UTC&quot;%3B } }" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_L)" Overwrite="true" WriteOnlyWhenDifferent="false" />
    <!--
      The OTHER half of the same stamp: the RELEASE identity (semantic version + short commit +
      dev/release), generated into the partial class whose hand-written half is
      src/GloomhavenVR/Core/BuildInfo.cs. It is written here, in the target that already runs
      git, so the release identity costs ZERO extra process launches per build.
      WriteOnlyWhenDifferent on purpose: unlike the file above it carries no timestamp, so an
      incremental build that changed nothing leaves it byte-identical and untouched.
      NOT NetProtocol.ModBuild — see the header of Core/BuildInfo.cs.
    -->
    <ItemGroup>
      <_B Include="namespace GloomhavenVR.Core { internal static partial class BuildInfo {" />
      <_B Include="public const string Version = &quot;$(Version)&quot;%3B" />
      <_B Include="public const string Commit = &quot;$(_GhvrCommit)&quot;%3B" />
      <_B Include="public const bool IsDevBuild = $(_GhvrIsDev)%3B } }" />
    </ItemGroup>
    <WriteLinesToFile File="$(_GhvrBuildInfoFile)" Lines="@(_B)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
      <Compile Include="$(_GhvrBuildInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
